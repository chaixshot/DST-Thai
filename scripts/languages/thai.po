msgid "Mighty Weapons IV"
msgstr "อาวุธอันยิ่งใหญ่ IV"

#. STRINGS.SKILLTREE.WOLFGANG.WOLFGANG_MIGHTY_PLANAR_DAMAGE_5_DESC
msgctxt "STRINGS.SKILLTREE.WOLFGANG.WOLFGANG_MIGHTY_PLANAR_DAMAGE_5_DESC"
msgid "Bring out the full strength of planar melee weapons.\nAdd +25 Planar Damage to planar melee weapons when Mighty."
msgstr "ดึงพลังสูงสุดของอาวุธประชิดระนาบออกมา\nเพิ่มความเสียหายระนาบ +25 ให้กับอาวุธประชิดระนาบเมื่อทรงพลัง"

#. STRINGS.SKILLTREE.WOLFGANG.WOLFGANG_MIGHTY_PLANAR_DAMAGE_5_TITLE
msgctxt "STRINGS.SKILLTREE.WOLFGANG.WOLFGANG_MIGHTY_PLANAR_DAMAGE_5_TITLE"
