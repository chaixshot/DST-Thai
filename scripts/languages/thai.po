msgstr "นั่นมันอันตราย! เผามัน!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WONKEY.REVIVER"
