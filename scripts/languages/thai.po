msgstr "ข้างในคงจะไม่มีอะไรน่าสนุก"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PEBBLECRAB"
