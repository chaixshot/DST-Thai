msgstr "ได้เวลาเตรียม carrat ของฉันแล้ว"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
