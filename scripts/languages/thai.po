msgstr "เฮ้ ถอยกลับ!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.1"
