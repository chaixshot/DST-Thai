msgstr "มันควรจะอยู่เหนือสระน้ำ"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP"
msgid "Sticky, icky sap!"
msgstr "เหนียวหนึบ!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's for filling up with sap."
msgstr "ใช้สำหรับเติมน้ำนม"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPLING"
