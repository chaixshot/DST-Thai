msgstr "การสังเคราะห์แสง"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED1_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED1_DESC"
msgid "Reach full bloom a bit quicker."
msgstr "บานเต็มที่เร็วขึ้นอีกนิด"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED1_TITLE
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED1_TITLE"
msgid "Growth Spurt I"
msgstr "การเติบโตกระฉูด I"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED2_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED2_DESC"
