#. STRINGS.DAYWALKER_IMPRISONED_FAR.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.2"
msgid "...(growl)..."
msgstr "...(คำราม)..."

#. STRINGS.DAYWALKER_IMPRISONED_FAR.3
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.3"
msgid "ME FOUND IT FIRST... ME!"
msgstr "ฉันพบมันก่อน... ฉัน!"

#. STRINGS.DAYWALKER_IMPRISONED_FAR.4
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.4"
msgid "...UUUGH..."
msgstr "...อือ..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.1"
msgid "FREE... ME..."
msgstr "ฟรี... ฉัน..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.2"
msgid "...UUGH..."
msgstr "...อือ..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.3
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.3"
msgid "COME... CLOSER..."
msgstr "มา... ใกล้กว่านี้..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.4
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.4"
msgid "PLEASE..."
msgstr "โปรด..."

#. STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.1"
msgid "YES!"
msgstr "ใช่!"

#. STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.2"
msgid "KEEP GOING!"
msgstr "ก้าวต่อไป!"

#. STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.3
msgctxt "STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.3"
msgid "HURRY! HURRY!"
msgstr "เร็วเข้า! เร็วเข้า!"

#. STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.1"
msgid "ITCHY!"
msgstr "คัน!"

#. STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.2"
msgid "CAN'T MOVE!"
msgstr "ขยับไม่ได้!"

#. STRINGS.DAYWALKER_LEECH_BITE.1
msgctxt "STRINGS.DAYWALKER_LEECH_BITE.1"
msgid "AHHH!"
msgstr "AHHH!"

#. STRINGS.DAYWALKER_LEECH_BITE.2
msgctxt "STRINGS.DAYWALKER_LEECH_BITE.2"
msgid "OW!!"
msgstr "โอ้ย!!"

#. STRINGS.DAYWALKER_POWERDOWN.1
msgctxt "STRINGS.DAYWALKER_POWERDOWN.1"
msgid "M-MY POWER..."
msgstr "พลังของฉัน..."

#. STRINGS.DAYWALKER_POWERDOWN.2
msgctxt "STRINGS.DAYWALKER_POWERDOWN.2"
msgid "THIS NOT OVER!"
msgstr "ยังไม่จบ!"

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.1
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.1"
msgid "CAN'T KEEP... ME HERE... FOREVER..."
msgstr "ไม่สามารถรักษา...ฉันไว้ที่นี่...ตลอดไป..."

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.2
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.2"
msgid "ME FIND CRACK TO DARK PLACE... ME!"
msgstr "ฉันพบรอยแตกในที่มืด... ฉัน!"

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.3
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.3"
msgid "POWER SHOULD BE FOR ME!"
msgstr "พลังควรเป็นของฉัน!"

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.4
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.4"
msgid "COWARDS!"
msgstr "ขี้ขลาด!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.1
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.1"
msgid "OFF OF ME!"
msgstr "ออกจากฉัน!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.2
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.2"
msgid "GET OFF!!"
msgstr "ออกไป!!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.3
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.3"
msgid "RAAAAUUGGHH!"
msgstr "น่าร๊ากกก!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.4
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.4"
msgid "VERMIN!"
msgstr "เวอร์มิน!"

#. STRINGS.DAYWALKER_TIRED.1
msgctxt "STRINGS.DAYWALKER_TIRED.1"
msgid "HUFF... HUFF..."
msgstr "ฮัฟ...ฮัฟ..."

#. STRINGS.DAYWALKER_TIRED.2
msgctxt "STRINGS.DAYWALKER_TIRED.2"
msgid "BETTER... YES, MUCH BETTER."
msgstr "ดีกว่า... ใช่ ดีกว่ามาก"

#. STRINGS.DEADCREATURE
msgctxt "STRINGS.DEADCREATURE"
msgid "Dead"
msgstr "ตาย"

#. STRINGS.DESCRIBE_NULL
msgctxt "STRINGS.DESCRIBE_NULL"
msgid "MISSING DESCRIPTION STRING"
msgstr "ไม่มีในรายการดังกล่าว"

#. STRINGS.DIRECTIONS.E
msgctxt "STRINGS.DIRECTIONS.E"
msgid "East"
msgstr "ทิศตะวันออก"

#. STRINGS.DIRECTIONS.N
msgctxt "STRINGS.DIRECTIONS.N"
msgid "North"
msgstr "ทิศเหนือ"

#. STRINGS.DIRECTIONS.NE
msgctxt "STRINGS.DIRECTIONS.NE"
msgid "Northeast"
msgstr "ทิศตะวันออกเฉียงเหนือ"

#. STRINGS.DIRECTIONS.NW
msgctxt "STRINGS.DIRECTIONS.NW"
msgid "Northwest"
msgstr "ทิศตะวันตกเฉียงเหนือ"

#. STRINGS.DIRECTIONS.S
msgctxt "STRINGS.DIRECTIONS.S"
msgid "South"
msgstr "ทิศใต้"

#. STRINGS.DIRECTIONS.SE
msgctxt "STRINGS.DIRECTIONS.SE"
msgid "Southeast"
msgstr "ทิศตะวันออกเฉียงใต้"

#. STRINGS.DIRECTIONS.SW
msgctxt "STRINGS.DIRECTIONS.SW"
msgid "Southwest"
msgstr "ทิศตะวันตกเฉียงใต้"

#. STRINGS.DIRECTIONS.W
msgctxt "STRINGS.DIRECTIONS.W"
msgid "West"
msgstr "ทิศตะวันตก"

#. STRINGS.DISEASEDITEM
msgctxt "STRINGS.DISEASEDITEM"
msgid "Diseased"
msgstr "(ติดโรค)"

#. STRINGS.DROPALL
msgctxt "STRINGS.DROPALL"
msgid "Drop All"
msgstr "ทิ้งทุกอย่าง"

#. STRINGS.ENGINEER_REMOTE.BOOST
msgctxt "STRINGS.ENGINEER_REMOTE.BOOST"
msgid "Barrage"
msgstr "การโจมตี"

#. STRINGS.ENGINEER_REMOTE.ELEMENTAL_VOLLEY
msgctxt "STRINGS.ENGINEER_REMOTE.ELEMENTAL_VOLLEY"
msgid "Planar Strike"
msgstr "การโจมตีแบบระนาบ"

#. STRINGS.ENGINEER_REMOTE.VOLLEY
msgctxt "STRINGS.ENGINEER_REMOTE.VOLLEY"
msgid "Target"
msgstr "เป้าหมาย"

#. STRINGS.ENGINEER_REMOTE.WAKEUP
msgctxt "STRINGS.ENGINEER_REMOTE.WAKEUP"
msgid "Arm Catapult"
msgstr "เครื่องยิงหนังสติ๊กแบบแขน"

#. STRINGS.EPITAPHS.1
msgctxt "STRINGS.EPITAPHS.1"
msgid "It says \"Come on in.\""
msgstr "มันบอก \"ลงมานี่ซิ\""

#. STRINGS.EPITAPHS.10
msgctxt "STRINGS.EPITAPHS.10"
msgid "There's just a big \"W\" etched in it."
msgstr "มันดูเหมือนจะมีอะไรผังอยู่ในนั้น"

#. STRINGS.EPITAPHS.11
msgctxt "STRINGS.EPITAPHS.11"
msgid "\"Not sick, just coffin.\""
msgstr "\"สบายดี มันก็แค่หลุมศพ\""

#. STRINGS.EPITAPHS.12
msgctxt "STRINGS.EPITAPHS.12"
msgid "\"Sweet slumber.\""
msgstr "\"นอนหลับฝันหวาน\""

#. STRINGS.EPITAPHS.13
msgctxt "STRINGS.EPITAPHS.13"
msgid "\"This world could not hold me.\""
msgstr "\"โลกนี้ไม่สามารถฝังฉันได้\""

#. STRINGS.EPITAPHS.14
msgctxt "STRINGS.EPITAPHS.14"
msgid "\"I didn't like it here anyway.\""
msgstr "\"ฉันไม่ชอบที่นี่อยู่แล้ว\""

#. STRINGS.EPITAPHS.15
msgctxt "STRINGS.EPITAPHS.15"
msgid "\"I've better places to be.\""
msgstr "\"ฉันได้ตำแหน่งดีกว่านี้\""

#. STRINGS.EPITAPHS.16
msgctxt "STRINGS.EPITAPHS.16"
msgid "\"It's dirty down here.\""
msgstr "\"ในนี้มันสกปรก\""

#. STRINGS.EPITAPHS.17
msgctxt "STRINGS.EPITAPHS.17"
msgid "\"Age makes fools of us all.\""
msgstr "\"อายุทำให้ทุกคนโง่\""

#. STRINGS.EPITAPHS.18
msgctxt "STRINGS.EPITAPHS.18"
msgid "\"Just needed a rest.\""
msgstr "\"แค่ต้องการพักผ่อนเท่านั้นเอง\""

#. STRINGS.EPITAPHS.19
msgctxt "STRINGS.EPITAPHS.19"
msgid "\"Five more minutes.\""
msgstr "\"ขอสักห้านาที\""

#. STRINGS.EPITAPHS.2
msgctxt "STRINGS.EPITAPHS.2"
msgid "\"Don't even think about it.\""
msgstr "\"อย่าแม้แต่จะคิดเกี่ยวกับมัน\""

#. STRINGS.EPITAPHS.20
msgctxt "STRINGS.EPITAPHS.20"
msgid "\"It's not as bad as it looks.\""
msgstr "\"มันไม่ได้เลวร้ายอย่างที่เห็น\""

#. STRINGS.EPITAPHS.21
msgctxt "STRINGS.EPITAPHS.21"
msgid "\"Quoth the tallbird, Evermore.\""
msgstr "\"แด่ที่รัก...ตลอดไป\""

#. STRINGS.EPITAPHS.22
msgctxt "STRINGS.EPITAPHS.22"
msgid "It says \"Finally, some peace and quiet.\""
msgstr "มันบอก \"ในที่สุด ทุกอย่าก็เงียบสงบ\""

#. STRINGS.EPITAPHS.23
msgctxt "STRINGS.EPITAPHS.23"
msgid "It says \"Mind your own business.\""
msgstr "มันบอก \"คุณรู้ว่าใครเป็นเจ้าของ\""

#. STRINGS.EPITAPHS.24
msgctxt "STRINGS.EPITAPHS.24"
msgid "It says \"Help, get me out!\" and \"Nah, just kidding,\" beneath."
msgstr "มันบอก \"ช่วยด้วย เอาฉันออกไปที!\" และ \"น่าาา ล้อเล่นน่ะ\""

#. STRINGS.EPITAPHS.25
msgctxt "STRINGS.EPITAPHS.25"
msgid "It reads \"Pulvis Et Umbra Sumus.\""
msgstr "มันอ่านว่า \"ฝุ่นและเงา\""

#. STRINGS.EPITAPHS.26
msgctxt "STRINGS.EPITAPHS.26"
msgid "An engraving of their last words: \"I love it so much I could just die!\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"ฉันรักมันมากดังนั้นฉันจะต้องตาย!\""

#. STRINGS.EPITAPHS.27
msgctxt "STRINGS.EPITAPHS.27"
msgid "An engraving of their last words: \"Hey, watch this.\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"เฮ้ ดูนี่ซิ\""

#. STRINGS.EPITAPHS.28
msgctxt "STRINGS.EPITAPHS.28"
msgid "An engraving of their last words: \"Uh-oh.\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"เอ่อโอ้\""

#. STRINGS.EPITAPHS.29
msgctxt "STRINGS.EPITAPHS.29"
msgid "An engraving of their last words: \"This is fine.\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"ที่นี่มันดีจัง\""

#. STRINGS.EPITAPHS.3
msgctxt "STRINGS.EPITAPHS.3"
msgid "\"Here lies some guy.\""
msgstr "\"ที่นี่บางคนแต่งตัวประหลาด\""

#. STRINGS.EPITAPHS.30
msgctxt "STRINGS.EPITAPHS.30"
msgid "An engraving of their last words: \"I'm out of here.\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"ฉันจะออกไปจากที่นี่\""

#. STRINGS.EPITAPHS.31
msgctxt "STRINGS.EPITAPHS.31"
msgid "An engraving of their last words: \"That's enough of that.\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"นั้นเพียงพอสำหรับที่นี่\""

#. STRINGS.EPITAPHS.32
msgctxt "STRINGS.EPITAPHS.32"
msgid "An engraving of their last words: \"I'd rather die!\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"ฉันอยากจะตาย!\""

#. STRINGS.EPITAPHS.33
msgctxt "STRINGS.EPITAPHS.33"
msgid "An engraving of their last words: \"Uh, okay bye.\""
msgstr "ถ้อยคำสุดท้ายของเขา: \"เอ่อ โอเค ลาก่อน\""

#. STRINGS.EPITAPHS.34
msgctxt "STRINGS.EPITAPHS.34"
msgid "It reads \"Right behind you...\" and \"Made you look!\""
msgstr "มันอ่านว่า \"ด้านหลังของคุณ...\" และ \"ทำให้คุณดู!\""

#. STRINGS.EPITAPHS.35
msgctxt "STRINGS.EPITAPHS.35"
msgid "\"Whoops.\""
msgstr "\"อ๊ะ\""

#. STRINGS.EPITAPHS.36
msgctxt "STRINGS.EPITAPHS.36"
msgid "It's cracked down the middle."
msgstr "มันแตกลงตรงกลาง"

#. STRINGS.EPITAPHS.37
msgctxt "STRINGS.EPITAPHS.37"
msgid "It says \"The end is only the beginning\"."
msgstr "มันบอก \"ท้ายที่สุดก็คือจุดเริ่มต้นเท่านั้น\""

#. STRINGS.EPITAPHS.38
msgctxt "STRINGS.EPITAPHS.38"
msgid "It says \"I was underground before it was a thing.\" Huh?"
msgstr "มันบอก \"ผมอยู่ใต้ดินก่อนที่มันจะเป็นสิ่งนี้\" ฮะ?"

#. STRINGS.EPITAPHS.39
msgctxt "STRINGS.EPITAPHS.39"
msgid "Someone left flowers."
msgstr "ใครบางคนลืมให้ดอกไม้"

#. STRINGS.EPITAPHS.4
msgctxt "STRINGS.EPITAPHS.4"
msgid "\"Here lies some gal.\""
msgstr "\"นี่มันบ้าอะไรกัน\""

#. STRINGS.EPITAPHS.40
msgctxt "STRINGS.EPITAPHS.40"
msgid "It's old and worn."
msgstr "มันทั้งเก่าทั้งเหม็น"

#. STRINGS.EPITAPHS.41
msgctxt "STRINGS.EPITAPHS.41"
msgid "It says \"Did I make it into the history books?\""
msgstr "มันบอก \"ไม่ทำฉันให้เป็นหนังสือประวัติศาสตร์หรอ?\""

#. STRINGS.EPITAPHS.42
msgctxt "STRINGS.EPITAPHS.42"
msgid "It says \"I'm taking a nap. In the dirt.\""
msgstr "มันบอก \"ฉันการหลับนอนในสิ่งสกปรก\""

#. STRINGS.EPITAPHS.43
msgctxt "STRINGS.EPITAPHS.43"
msgid "It says \"These are just the pieces we could find.\""
msgstr "มันบอก \"เหล่านี้เป็นเพียงชิ้นส่วนที่เราจะสามารถหาได้\""

#. STRINGS.EPITAPHS.44
msgctxt "STRINGS.EPITAPHS.44"
msgid "It says \"See you on the other side.\""
msgstr "มันบอก \"เห็นคุณในด้านอื่นๆ\""

#. STRINGS.EPITAPHS.45
msgctxt "STRINGS.EPITAPHS.45"
msgid "It says \"Catch you later.\""
msgstr "มันบอก \"เอาไว้ค่อยคุยกัน\""

#. STRINGS.EPITAPHS.46
msgctxt "STRINGS.EPITAPHS.46"
msgid "It says \"Don't make fun. You'll be here too one day.\""
msgstr "มันบอก \"อย่าทำตัวสนุกสนาน คุณจะอยู่ที่นี่มั่งสักวันหนึ่ง\""

#. STRINGS.EPITAPHS.47
msgctxt "STRINGS.EPITAPHS.47"
msgid "It says \"On to the next adventure.\""
msgstr "มันบอก \"ในการผจญภัยต่อไป\""

#. STRINGS.EPITAPHS.48
msgctxt "STRINGS.EPITAPHS.48"
msgid "\"It's worse than it looks.\""
msgstr "\"มันเลวร้ายยิ่งกว่าที่เห็น\""

#. STRINGS.EPITAPHS.49
msgctxt "STRINGS.EPITAPHS.49"
msgid "\"This is where I keep my stuff.\""
msgstr "\"มันดีที่จะเก็บสิ่งนั้นไว้\""

#. STRINGS.EPITAPHS.5
msgctxt "STRINGS.EPITAPHS.5"
msgid "\"Here lies some person.\""
msgstr "\"มีบางคนอยู่ที่นี่\""

#. STRINGS.EPITAPHS.50
msgctxt "STRINGS.EPITAPHS.50"
msgid "It says \"I'm just pretending.\""
msgstr "มันบอก \"ฉันแค่แกล้ง\""

#. STRINGS.EPITAPHS.51
msgctxt "STRINGS.EPITAPHS.51"
msgid "It reads \"Is the coast clear yet?\""
msgstr "มันอ่านว่า \"อยากลงมาไหม?\""

#. STRINGS.EPITAPHS.52
msgctxt "STRINGS.EPITAPHS.52"
msgid "It says \"Lost and Found\"."
msgstr "มันบอก \"พบและจาก\""

#. STRINGS.EPITAPHS.53
msgctxt "STRINGS.EPITAPHS.53"
msgid "It says \"I hope I turned the oven off.\""
msgstr "มันบอก \"ฉันหวังว่าฉันจะได้เปิดเตาอบ\""

#. STRINGS.EPITAPHS.54
msgctxt "STRINGS.EPITAPHS.54"
msgid "It says \"Right where I belong.\""
msgstr "มันบอก \"แน่นอน ฉันอยู่ที่นี่\""

#. STRINGS.EPITAPHS.55
msgctxt "STRINGS.EPITAPHS.55"
msgid "It says \"I guess this is my life now.\""
msgstr "มันบอก \"ฉันคิดว่านี่คือชีวิตของฉันตอนนี้\""

#. STRINGS.EPITAPHS.56
msgctxt "STRINGS.EPITAPHS.56"
msgid "\"Not sick, just coffin.\""
msgstr "\"สบายดี แค่หลุมศพ\""

#. STRINGS.EPITAPHS.57
msgctxt "STRINGS.EPITAPHS.57"
msgid "\"Beware.\" Beware of what?"
msgstr "\"ระวัง \" ระวังอะไร?"

#. STRINGS.EPITAPHS.58
msgctxt "STRINGS.EPITAPHS.58"
msgid "It's covered in a peaceful moss."
msgstr "มันครอบคลุมในตะไคร่น้ำที่เงียบสงบ"

#. STRINGS.EPITAPHS.59
msgctxt "STRINGS.EPITAPHS.59"
msgid "It reads \"I've made a grave error.\" Hm."
msgstr "มันอ่านว่า \"ผมได้ทำผิดพลาด\" หึ่ม"

#. STRINGS.EPITAPHS.6
msgctxt "STRINGS.EPITAPHS.6"
msgid "The headstone is blank."
msgstr "ป้ายหลุมศพว่างเปล่า"

#. STRINGS.EPITAPHS.60
msgctxt "STRINGS.EPITAPHS.60"
msgid "It reads \"I can dig it.\" Oh."
msgstr "มันอ่านว่า \"ฉันสามารถขุดมัน\" โอ้"

#. STRINGS.EPITAPHS.61
msgctxt "STRINGS.EPITAPHS.61"
msgid "It reads \"Care to join me?\""
msgstr "มันอ่านว่า \"อยากมาอยู่กับฉันไหม?\""

#. STRINGS.EPITAPHS.62
msgctxt "STRINGS.EPITAPHS.62"
msgid "It reads \"Don't worry, it's cozy.\" That's nice."
msgstr "มันอ่านว่า \"อน่ากังวนไปเลย\" ในนี้อยู่สบาย"

#. STRINGS.EPITAPHS.63
msgctxt "STRINGS.EPITAPHS.63"
msgid "\"And don't come back.\""
msgstr "\"และไม่กลับมา\""

#. STRINGS.EPITAPHS.64
msgctxt "STRINGS.EPITAPHS.64"
msgid "The inscription reads \"Always Watching\". Odd."
msgstr "มันเขียนว่า \"ดูอยู่เสมอ\" ประหลาดแหะ"

#. STRINGS.EPITAPHS.7
msgctxt "STRINGS.EPITAPHS.7"
msgid "\"Milk. Eggs. Bacon.\""
msgstr "\"นม ไข่ เบคอน\""

#. STRINGS.EPITAPHS.8
msgctxt "STRINGS.EPITAPHS.8"
msgid "Huh? That's my name!"
msgstr "เฮ้ย? นั้นชื่อของฉันนิ!"

#. STRINGS.EPITAPHS.9
msgctxt "STRINGS.EPITAPHS.9"
msgid "It reads \"You're standing on my face.\" Oops."
msgstr "มันอ่านว่า \"คุณกำลังยืนอยู่บนหน้าของฉัน\" อุ๋ย"

#. STRINGS.EYEOFTERROR_CANCEL
msgctxt "STRINGS.EYEOFTERROR_CANCEL"
msgid "The evil presence has subsided."
msgstr "การปรากฏตัวของความชั่วร้ายได้ลดลง"

#. STRINGS.EYEOFTERROR_COMING
msgctxt "STRINGS.EYEOFTERROR_COMING"
msgid "You feel an evil presence watching you..."
msgstr "คุณรู้สึกถึงความชั่วร้ายที่มองคุณอยู่.."

#. STRINGS.EYEOFTERROR_TARGET
msgctxt "STRINGS.EYEOFTERROR_TARGET"
msgid "The Eye of Terror turns its gaze toward {player_name}"
msgstr "ตาแห่งความหวาดกลัวหันมองไปทาง {player_name}"

#. STRINGS.GHOSTCOMMANDS.ATTACK_AT
msgctxt "STRINGS.GHOSTCOMMANDS.ATTACK_AT"
msgid "Attack At"
msgstr "โจมตีที่"

#. STRINGS.GHOSTCOMMANDS.ESCAPE
msgctxt "STRINGS.GHOSTCOMMANDS.ESCAPE"
msgid "Escape"
msgstr "หนี"

