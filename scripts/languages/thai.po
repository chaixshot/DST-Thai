msgstr "บีฟาโล่ของเราอยู่ไกลเกินไป!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.LOWER_SAIL_FAIL.1"
