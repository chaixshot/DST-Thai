msgstr "เราคิดว่านั่นจะทำให้โกรธ"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
