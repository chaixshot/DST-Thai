msgstr "เราควรสร้างสิ่งนี้"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.COOKBOOK"
