msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Let's not wake it."
msgstr "อย่าปลุกมัน"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUTATEDWARG"
