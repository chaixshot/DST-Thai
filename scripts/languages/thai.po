msgstr "\nฉันเชื่อว่าฉันสามารถซ่อมแซมมันได้"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "Ah non, I'm missing some ingredients!"
msgstr "อ๊ะ ฉันขาดส่วนผสมบางอย่าง!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CANNOT_BUILD.NO_STATION"
