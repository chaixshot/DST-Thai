msgstr "ในที่สุด เสากระโดงใหม่ที่สวยงาม!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_YOTD"
