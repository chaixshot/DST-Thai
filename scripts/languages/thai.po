msgstr "อาวุธทรงพลัง V"

#. STRINGS.SKILLTREE.WOLFGANG.WOLFGANG_NORMAL_SPEED_DESC
msgctxt "STRINGS.SKILLTREE.WOLFGANG.WOLFGANG_NORMAL_SPEED_DESC"
