msgstr "โดนแล้ว!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_RABBITKING_PASSIVE"
