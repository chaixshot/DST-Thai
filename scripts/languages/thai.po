msgstr "จานสำหรับเครื่องปรุงรสทั้งหมด"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
