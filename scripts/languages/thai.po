msgstr "อนุสรณ์สถานอันยิ่งใหญ่"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
