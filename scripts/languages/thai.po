msgstr "โอ้ย เราพลาดแล้ว!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DRAW.NOIMAGE"
