msgstr "หมวกสวยดี"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_ROYALTY.2"
