msgstr "เผาให้หมด %s! เผามัน!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.GENERIC"
msgid "Hi %s!"
msgstr "สวัสดี %s!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WOODIE.GHOST"
