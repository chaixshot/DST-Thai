msgstr "ต้นไม้ทารกน้อยจิ๋ว"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP_SPOILED"
