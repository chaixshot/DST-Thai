msgstr "ฉันรู้แค่ที่ของมัน"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "That rabbit can really light up a room."
msgstr "กระต่ายตัวนั้นทำให้ห้องสว่างได้จริงๆ"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "That rabbit isn't lighting up anything."
msgstr "กระต่ายตัวนั้นไม่ได้จุดไฟอะไรเลย"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2_ITEM"
