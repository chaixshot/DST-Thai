msgstr "เบอร์รี่พวกนั้นหมดแล้ว"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_BOWL_SILVER"
